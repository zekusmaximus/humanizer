{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/human_rating.schema.json",
  "title": "Benchmark v2 individual human rating",
  "type": "object",
  "required": ["schema_version", "record_type", "rating_id", "rater_id_pseudonym", "dimension", "scale_id", "rated_at", "adjudication_status"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "human_rating"},
    "rating_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": ["string", "null"], "minLength": 1},
    "revision_id": {"type": ["string", "null"], "minLength": 1},
    "rater_id_pseudonym": {"type": "string", "minLength": 1},
    "dimension": {"type": "string", "minLength": 1},
    "scale_id": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "null"]},
    "preference": {"enum": ["left", "tie", "right", null]},
    "blind_order": {"enum": ["source_left", "source_right", null]},
    "rated_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+]00:00)$"},
    "adjudication_status": {"enum": ["not_needed", "pending", "adjudicated"]}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {"pair_id": {"type": "string", "minLength": 1}, "revision_id": {"type": "null"}},
          "required": ["pair_id", "revision_id"]
        },
        {
          "properties": {"pair_id": {"type": "null"}, "revision_id": {"type": "string", "minLength": 1}},
          "required": ["pair_id", "revision_id"]
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {"value": {"type": "number"}, "preference": {"type": "null"}},
          "required": ["value", "preference"]
        },
        {
          "properties": {"value": {"type": "null"}, "preference": {"enum": ["left", "tie", "right"]}},
          "required": ["value", "preference"]
        }
      ]
    }
  ]
}
