{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/sample_revision.schema.json",
  "title": "Benchmark v2 sample revision",
  "type": "object",
  "required": ["schema_version", "record_type", "dataset_id", "dataset_snapshot_id", "annotation_scheme_id", "revision_id", "document_id", "source_group_id", "parent_revision_ids", "track", "split_role", "stage", "text_availability", "analysis_eligibility", "analysis_exclusion_reasons", "language_bcp47", "domain", "genre", "process_class", "surface_class", "assistance_modes", "assistance_extent", "ground_truth_basis", "label_status", "rights_status", "privacy_tier"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "sample_revision"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_snapshot_id": {"type": "string", "minLength": 1},
    "annotation_scheme_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "legacy_sample_id": {"type": ["string", "null"]},
    "document_id": {"type": "string", "minLength": 1},
    "source_group_id": {"type": "string", "minLength": 1},
    "author_cluster_id": {"type": ["string", "null"]},
    "prompt_family_id": {"type": ["string", "null"]},
    "collection_batch_id": {"type": ["string", "null"]},
    "parent_revision_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "track": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["A", "B", "C", "D"]}},
    "split_role": {"enum": ["train", "calibration", "threshold_audit", "test", "challenge"]},
    "text_availability": {"enum": ["available", "unavailable_legacy"]},
    "analysis_eligibility": {"enum": ["eligible", "excluded"]},
    "analysis_exclusion_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stage": {"type": "string", "minLength": 1},
    "language_bcp47": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "genre": {"type": "string", "minLength": 1},
    "process_class": {"enum": ["human_only", "model_generated", "human_then_model", "model_then_human", "interleaved", "unknown"]},
    "surface_class": {"enum": ["human", "machine", "mixed", "assisted", "unknown"]},
    "assistance_modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["completion", "rewrite", "proofread", "grammar", "translation", "summarization", "ideation_only", "accessibility_tool", "other"]}},
    "assistance_extent": {"enum": ["none", "minimal", "substantive", "unknown"]},
    "ground_truth_basis": {"enum": ["controlled_generation_log", "version_history_adjudicated", "author_attested", "dataset_claim", "unknown"]},
    "label_status": {"enum": ["verified", "adjudicated", "attested", "provisional", "unknown"]},
    "rights_status": {"enum": ["verified", "restricted", "unknown"]},
    "license_id": {"type": ["string", "null"]},
    "consent_id": {"type": ["string", "null"]},
    "privacy_tier": {"enum": ["public", "internal", "restricted"]},
    "raw_bytes_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "normalized_text_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "raw_hash_scope": {"enum": ["exact_file_bytes", null]},
    "char_count": {"type": ["integer", "null"], "minimum": 0},
    "word_count": {"type": ["integer", "null"], "minimum": 0},
    "created_at": {"type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"},
    "migrated_at": {"type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"}
  },
  "allOf": [
    {
      "if": {"properties": {"text_availability": {"const": "available"}}},
      "then": {
        "required": ["raw_bytes_sha256", "text_encoding", "raw_hash_scope", "normalized_text_sha256", "annotation_normalization", "char_count", "word_count", "created_at"],
        "properties": {
          "raw_bytes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "text_encoding": {"type": "string", "minLength": 1},
          "raw_hash_scope": {"const": "exact_file_bytes"},
          "normalized_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "annotation_normalization": {"type": "string", "minLength": 1},
          "char_count": {"type": "integer", "minimum": 0},
          "word_count": {"type": "integer", "minimum": 0},
          "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"}
        },
        "anyOf": [
          {"required": ["text_ref"], "properties": {"text_ref": {"type": "string", "minLength": 1}}},
          {"required": ["text"], "properties": {"text": {"type": "string"}}}
        ]
      }
    },
    {
      "if": {"properties": {"text_availability": {"const": "unavailable_legacy"}}},
      "then": {
        "properties": {
          "label_status": {"const": "provisional"},
          "analysis_eligibility": {"const": "excluded"},
          "text_ref": {"type": "null"},
          "raw_bytes_sha256": {"type": "null"},
          "text_encoding": {"type": "null"},
          "raw_hash_scope": {"type": "null"},
          "normalized_text_sha256": {"type": "null"},
          "annotation_normalization": {"type": "null"},
          "char_count": {"type": "null"},
          "word_count": {"type": "null"}
        },
        "required": ["migrated_at"]
      }
    }
  ]
}
