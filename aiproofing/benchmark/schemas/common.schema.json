{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/common.schema.json",
  "title": "Benchmark v2 common definitions",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "recordHeader": {
      "type": "object",
      "required": ["schema_version", "record_type"],
      "properties": {"schema_version": {"const": "2.0.0"}}
    }
  }
}
