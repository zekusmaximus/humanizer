{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/lineage_event.schema.json",
  "title": "Benchmark v2 lineage event",
  "type": "object",
  "required": ["schema_version", "record_type", "event_id", "output_revision_id", "input_revision_ids", "action", "actor_kind", "human_oversight_internal", "approval_status"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "lineage_event"},
    "event_id": {"type": "string", "minLength": 1},
    "output_revision_id": {"type": "string", "minLength": 1},
    "input_revision_ids": {"type": "array", "items": {"type": "string"}},
    "action": {"enum": ["generated", "completed", "rewrite", "proofread", "translate", "human_edit"]},
    "actor_kind": {"enum": ["human", "model", "tool", "unknown"]},
    "model_provider": {"type": ["string", "null"]},
    "model_id": {"type": ["string", "null"]},
    "model_version": {"type": ["string", "null"]},
    "model_revision": {"type": ["string", "null"]},
    "tool_id": {"type": ["string", "null"]},
    "tool_version": {"type": ["string", "null"]},
    "prompt_ref": {"type": ["string", "null"]},
    "system_prompt_ref": {"type": ["string", "null"]},
    "generation_parameters": {"type": ["object", "null"]},
    "started_at": {"type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"},
    "completed_at": {"type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"},
    "human_oversight_internal": {"enum": ["none", "prompt_guided", "reviewed", "edited", "unknown"]},
    "approval_status": {"enum": ["approved", "rejected", "pending", "not_applicable", "unknown"]}
  }
}
