{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/revision_pair.schema.json",
  "title": "Benchmark v2 revision pair",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "pair_id",
    "source_revision_id",
    "candidate_revision_id",
    "pair_kind",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "revision_pair"},
    "pair_id": {"type": "string", "minLength": 1},
    "source_revision_id": {"type": "string", "minLength": 1},
    "candidate_revision_id": {"type": "string", "minLength": 1},
    "pair_kind": {"enum": ["editorial_before_after", "blinded_comparison"]},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"}
  }
}
