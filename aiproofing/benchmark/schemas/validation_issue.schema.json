{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/validation_issue.schema.json",
  "title": "Benchmark v2 validation issue ledger record",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "issue_id",
    "severity",
    "code",
    "subject_record_type",
    "record_locator",
    "message"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "validation_issue"},
    "issue_id": {"type": "string", "minLength": 1},
    "severity": {"enum": ["error", "warning", "info"]},
    "code": {"type": "string", "minLength": 1},
    "subject_record_type": {"type": "string", "minLength": 1},
    "record_locator": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "field": {"type": ["string", "null"]},
    "raw_value_ref": {"type": ["string", "null"]},
    "suggested_action": {"type": ["string", "null"]}
  }
}
