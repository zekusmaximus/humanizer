{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/calibration_threshold.schema.json",
  "title": "Benchmark v2 calibrator and threshold records",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "record_type", "calibrator_id", "detector_id", "detector_version", "task_id", "input_signal_name", "method", "target_class", "scope", "fit_manifest_hash", "code_version", "artifact_hash", "fit_group_count", "fitted_at", "status"],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "record_type": {"const": "calibrator"},
        "calibrator_id": {"type": "string", "minLength": 1},
        "detector_id": {"type": "string", "minLength": 1},
        "detector_version": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "input_signal_name": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "target_class": {"type": "string", "minLength": 1},
        "scope": {"type": "object"},
        "fit_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fit_group_count": {"type": "integer", "minimum": 1},
        "reference_prevalence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "status": {"enum": ["active", "expired", "invalidated"]}
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "record_type", "threshold_id", "task_id", "target_class", "decision_schema_id", "input_signal_ref", "input_signal_stage", "selection_method", "selection_manifest_hash", "risk_policy", "fpr_bound_method", "confidence_level", "abstention_semantics", "eligible_scope", "selected_at", "frozen_at", "expires_at", "status"],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "record_type": {"const": "threshold"},
        "threshold_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "target_class": {"type": "string", "minLength": 1},
        "decision_schema_id": {"type": "string", "minLength": 1},
        "input_signal_ref": {"type": "string", "minLength": 1},
        "input_signal_stage": {"enum": ["raw", "calibrated"]},
        "calibrator_id": {"type": ["string", "null"]},
        "selection_method": {"enum": ["separate_audit", "neyman_pearson", "conformal", "tolerance_bound"]},
        "selection_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "audit_manifest_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "fpr_bound_method": {"enum": ["clopper_pearson_upper", "binomial_tolerance_bound", "cluster_aware_tolerance_bound", "neyman_pearson_bound", "conformal_risk_control"]},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "threshold_lower": {"type": ["number", "null"]},
        "threshold_upper": {"type": ["number", "null"]},
        "eligible_scope": {"type": "object"},
        "calibration_group_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "selection_group_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "audit_group_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "test_group_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["active", "expired", "invalidated"]}
      },
      "allOf": [
        {"required": ["selection_group_ids", "test_group_ids"]},
        {"if": {"properties": {"input_signal_stage": {"const": "raw"}}, "required": ["input_signal_stage"]}, "then": {"properties": {"calibrator_id": {"type": "null"}, "input_signal_ref": {"pattern": "^detector:[A-Za-z0-9_-]+[.][A-Za-z0-9_.:-]+$"}}}},
        {"if": {"properties": {"input_signal_stage": {"const": "calibrated"}}, "required": ["input_signal_stage"]}, "then": {"required": ["calibrator_id", "calibration_group_ids"], "properties": {"calibrator_id": {"type": "string", "minLength": 1}, "input_signal_ref": {"pattern": "^calibrator:[A-Za-z0-9_.:-]+[.]output$"}}}},
        {"if": {"properties": {"selection_method": {"const": "separate_audit"}}, "required": ["selection_method"]}, "then": {"required": ["audit_manifest_hash", "audit_group_ids"], "properties": {"audit_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "fpr_bound_method": {"enum": ["clopper_pearson_upper", "binomial_tolerance_bound", "cluster_aware_tolerance_bound"]}}}},
        {"if": {"properties": {"selection_method": {"const": "neyman_pearson"}}, "required": ["selection_method"]}, "then": {"properties": {"fpr_bound_method": {"const": "neyman_pearson_bound"}}}},
        {"if": {"properties": {"selection_method": {"const": "conformal"}}, "required": ["selection_method"]}, "then": {"properties": {"fpr_bound_method": {"const": "conformal_risk_control"}}}},
        {"if": {"properties": {"selection_method": {"const": "tolerance_bound"}}, "required": ["selection_method"]}, "then": {"properties": {"fpr_bound_method": {"enum": ["binomial_tolerance_bound", "cluster_aware_tolerance_bound"]}}}},
        {"anyOf": [{"required": ["threshold_lower"], "properties": {"threshold_lower": {"type": "number"}}}, {"required": ["threshold_upper"], "properties": {"threshold_upper": {"type": "number"}}}]}
      ]
    }
  ]
}
