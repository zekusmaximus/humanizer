{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/detector_run.schema.json",
  "title": "Benchmark v2 detector run",
  "type": "object",
  "required": ["schema_version", "record_type", "run_id", "revision_id", "task_id", "status", "detector_id", "provider", "detector_version", "adapter_version", "queried_at"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "detector_run"},
    "run_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ok", "abstained", "unsupported_language", "unsupported_configuration", "too_short", "input_too_long", "not_run", "policy_expired", "authorization_failed", "quota_blocked", "privacy_blocked", "rate_limited", "timeout", "provider_error", "parse_error", "invalid_response"]},
    "detector_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "detector_version": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "queried_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"},
    "config_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "raw_signals": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["name", "value_type", "value", "direction", "provider_meaning"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value_type": {"enum": ["number", "string", "boolean"]},
          "value": {},
          "direction": {"enum": ["higher_machine", "higher_human", "categorical", "none"]},
          "provider_meaning": {"type": "string", "minLength": 1},
          "scale_min": {"type": ["number", "null"]},
          "scale_max": {"type": ["number", "null"]},
          "provider_reported_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        },
        "allOf": [
          {"if": {"properties": {"value_type": {"const": "number"}}}, "then": {"properties": {"value": {"type": "number"}}}},
          {"if": {"properties": {"value_type": {"const": "string"}}}, "then": {"properties": {"value": {"type": "string"}, "direction": {"enum": ["categorical", "none"]}}}},
          {"if": {"properties": {"value_type": {"const": "boolean"}}}, "then": {"properties": {"value": {"type": "boolean"}, "direction": {"enum": ["categorical", "none"]}}}}
        ]
      }
    },
    "calibrated_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "raw_output_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "raw_spans": {"type": ["array", "null"], "items": {"type": "object"}},
    "threshold_id": {"type": ["string", "null"]},
    "decision_input_signal_ref": {"type": ["string", "null"]},
    "decision_schema_id": {"type": ["string", "null"]},
    "decision_label": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {
        "required": ["config_hash", "raw_signals"],
        "properties": {"config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "raw_signals": {"type": "array", "minItems": 1}}
      }
    },
    {
      "if": {"properties": {"decision_label": {"type": "string"}}},
      "then": {"properties": {"decision_schema_id": {"type": "string"}}, "required": ["decision_schema_id"]}
    },
    {
      "if": {"properties": {"decision_schema_id": {"type": "string"}}},
      "then": {"properties": {"decision_label": {"type": "string"}}, "required": ["decision_label"]}
    },
    {
      "if": {"properties": {"threshold_id": {"type": "string"}}},
      "then": {"properties": {"decision_input_signal_ref": {"type": "string"}}, "required": ["decision_input_signal_ref", "decision_schema_id", "decision_label"]}
    },
    {
      "if": {"properties": {"decision_input_signal_ref": {"type": "string"}}},
      "then": {"properties": {"threshold_id": {"type": "string"}}, "required": ["threshold_id"]}
    },
    {
      "if": {"properties": {"calibrated_probability": {"type": "number"}}},
      "then": {"required": ["calibration_input_signal", "calibrator_id"], "properties": {"calibration_input_signal": {"type": "string"}, "calibrator_id": {"type": "string"}}}
    }
  ]
}
