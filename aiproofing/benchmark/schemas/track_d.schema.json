{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/track_d.schema.json",
  "title": "Benchmark v2 Track D record contracts",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "record_type", "watermark_run_id", "revision_id", "scheme_id", "scheme_version", "generator_id", "generator_version", "watermark_ground_truth", "watermark_ground_truth_basis", "detector_id", "detector_version", "config_hash", "control_condition", "tokenizer_id", "tokenizer_version", "token_count", "status", "queried_at"],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "record_type": {"const": "watermark_run"},
        "watermark_run_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "minLength": 1},
        "scheme_id": {"type": "string", "minLength": 1},
        "scheme_version": {"type": "string", "minLength": 1},
        "generator_id": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1},
        "watermark_ground_truth": {"enum": ["present", "absent", "unknown"]},
        "control_condition": {"enum": ["correct_key", "wrong_key", "no_key"]},
        "detector_id": {"type": "string", "minLength": 1},
        "detector_version": {"type": "string", "minLength": 1},
        "tokenizer_id": {"type": "string", "minLength": 1},
        "tokenizer_version": {"type": "string", "minLength": 1},
        "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "token_count": {"type": "integer", "minimum": 0},
        "key_id": {"type": ["string", "null"]},
        "key_version": {"type": ["string", "null"]},
        "raw_statistic_name": {"type": ["string", "null"]},
        "raw_statistic_value": {"type": ["number", "null"]},
        "status": {"enum": ["ok", "abstained", "unsupported_language", "unsupported_configuration", "too_short", "input_too_long", "not_run", "policy_expired", "authorization_failed", "quota_blocked", "privacy_blocked", "rate_limited", "timeout", "provider_error", "parse_error", "invalid_response"]}
      },
      "allOf": [
        {
          "if": {"properties": {"watermark_ground_truth": {"enum": ["present", "absent"]}}},
          "then": {"required": ["generation_watermark_config_id", "ground_truth_log_ref"], "properties": {"generation_watermark_config_id": {"type": "string"}, "ground_truth_log_ref": {"type": "string"}}}
        },
        {
          "if": {"properties": {"control_condition": {"const": "no_key"}}},
          "then": {"properties": {"key_id": {"type": "null"}, "key_version": {"type": "null"}}}
        },
        {
          "if": {"properties": {"control_condition": {"enum": ["correct_key", "wrong_key"]}}},
          "then": {"required": ["key_id", "key_version"], "properties": {"key_id": {"type": "string", "minLength": 1}, "key_version": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "ok"}}},
          "then": {"required": ["raw_statistic_name", "raw_statistic_value"], "properties": {"raw_statistic_name": {"type": "string", "minLength": 1}, "raw_statistic_value": {"type": "number"}}}
        }
      ]
    },
    {
      "type": "object",
      "required": ["schema_version", "record_type", "verification_id", "revision_id", "asset_raw_bytes_sha256", "verifier_id", "verifier_version", "presence_state", "manifest_recovery_state", "asset_binding_state", "signature_state", "credential_trust_state", "revocation_state", "timestamp_state", "assertion_parse_state", "raw_validation_codes", "verified_at"],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "record_type": {"const": "provenance_verification"},
        "verification_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "minLength": 1},
        "asset_raw_bytes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verifier_id": {"type": "string", "minLength": 1},
        "verifier_version": {"type": "string", "minLength": 1},
        "presence_state": {"enum": ["present", "not_present", "unsupported", "indeterminate"]},
        "manifest_recovery_state": {"enum": ["recovered", "not_recovered", "not_applicable", "not_evaluated", "indeterminate", "unsupported"]},
        "asset_binding_state": {"enum": ["valid", "invalid", "not_applicable", "not_evaluated", "indeterminate"]},
        "signature_state": {"enum": ["valid", "invalid", "not_applicable", "not_evaluated", "indeterminate"]},
        "credential_trust_state": {"enum": ["trusted", "untrusted", "unknown", "not_applicable", "not_evaluated", "indeterminate"]},
        "revocation_state": {"enum": ["good", "revoked", "unknown", "not_applicable", "not_evaluated", "indeterminate"]},
        "timestamp_state": {"enum": ["valid", "invalid", "missing", "not_applicable", "not_evaluated", "indeterminate"]},
        "assertion_parse_state": {"enum": ["parsed", "parse_error", "not_applicable", "not_evaluated", "indeterminate", "unsupported"]},
        "raw_validation_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "verified_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+]00:00)$"},
        "manifest_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "spec_id": {"type": ["string", "null"]},
        "spec_version": {"type": ["string", "null"]},
        "trust_list_id": {"type": ["string", "null"]},
        "trust_list_version": {"type": ["string", "null"]},
        "signer_subject_ref": {"type": ["string", "null"]},
        "extracted_assertions_ref": {"type": ["string", "null"]},
        "signed_manifest_ref": {"type": ["string", "null"]},
        "crjson_ref": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"presence_state": {"enum": ["not_present", "unsupported"]}}},
          "then": {
            "properties": {
              "manifest_hash": {"type": "null"},
              "spec_id": {"type": "null"},
              "spec_version": {"type": "null"},
              "trust_list_id": {"type": "null"},
              "trust_list_version": {"type": "null"},
              "signer_subject_ref": {"type": "null"},
              "extracted_assertions_ref": {"type": "null"},
              "signed_manifest_ref": {"type": "null"},
              "crjson_ref": {"type": "null"},
              "asset_binding_state": {"enum": ["not_applicable", "not_evaluated", "indeterminate"]},
              "signature_state": {"enum": ["not_applicable", "not_evaluated", "indeterminate"]}
            }
          }
        },
        {
          "if": {"properties": {"manifest_recovery_state": {"const": "recovered"}}},
          "then": {
            "required": ["manifest_hash", "spec_id", "spec_version"],
            "properties": {
              "presence_state": {"const": "present"},
              "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "spec_id": {"type": "string", "minLength": 1},
              "spec_version": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "required": ["schema_version", "record_type", "generation_record_id", "output_revision_id", "payload_schema_version", "canonicalization_id", "canonicalization_version", "payload_hash", "output_raw_bytes_sha256", "parent_hashes", "action", "actor_kind", "created_at", "authentication_state"],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "record_type": {"const": "generation_record"},
        "generation_record_id": {"type": "string", "minLength": 1},
        "output_revision_id": {"type": "string", "minLength": 1},
        "payload_schema_version": {"type": "string", "minLength": 1},
        "canonicalization_id": {"type": "string", "minLength": 1},
        "canonicalization_version": {"type": "string", "minLength": 1},
        "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output_raw_bytes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "parent_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "action": {"enum": ["generated", "completed", "rewrite", "proofread", "translate", "human_edit"]},
        "actor_kind": {"enum": ["human", "model", "tool", "unknown"]},
        "authentication_state": {"enum": ["unsigned", "signed", "verified", "invalid"]},
        "created_at": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+]00:00)$"},
        "provider": {"type": ["string", "null"]},
        "model_id": {"type": ["string", "null"]},
        "model_version": {"type": ["string", "null"]},
        "model_revision": {"type": ["string", "null"]},
        "tool_id": {"type": ["string", "null"]},
        "tool_version": {"type": ["string", "null"]},
        "prompt_ref": {"type": ["string", "null"]},
        "system_prompt_ref": {"type": ["string", "null"]},
        "generation_parameters": {"type": ["object", "null"]},
        "envelope_type": {"enum": ["JWS", "DSSE", "C2PA", null]},
        "envelope_ref": {"type": ["string", "null"]},
        "envelope_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "signer_ref": {"type": ["string", "null"]},
        "key_id": {"type": ["string", "null"]},
        "signed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"authentication_state": {"const": "unsigned"}}},
          "then": {
            "properties": {
              "envelope_type": {"type": "null"},
              "envelope_ref": {"type": "null"},
              "envelope_hash": {"type": "null"},
              "signer_ref": {"type": "null"},
              "key_id": {"type": "null"},
              "signed_at": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"authentication_state": {"enum": ["signed", "verified"]}}},
          "then": {
            "required": ["envelope_type", "envelope_ref", "envelope_hash", "signer_ref", "key_id", "signed_at"],
            "properties": {
              "envelope_type": {"enum": ["JWS", "DSSE", "C2PA"]},
              "envelope_ref": {"type": "string", "minLength": 1},
              "envelope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "signer_ref": {"type": "string", "minLength": 1},
              "key_id": {"type": "string", "minLength": 1},
              "signed_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      ]
    }
  ]
}
