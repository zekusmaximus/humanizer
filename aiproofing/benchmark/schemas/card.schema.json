{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/card.schema.json",
  "title": "Benchmark v2 dataset, detector, and result card metadata",
  "type": "object",
  "required": [
    "card_schema_version",
    "card_type",
    "card_id",
    "evidence_status",
    "claim_boundary",
    "limitations"
  ],
  "properties": {
    "card_schema_version": {"const": "2.0.0"},
    "card_type": {"enum": ["dataset", "detector", "result"]},
    "card_id": {"type": "string", "minLength": 1},
    "evidence_status": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_snapshot_id": {"type": "string", "minLength": 1},
    "dataset_card_ref": {"type": "string", "minLength": 1},
    "detector_card_ref": {"type": "string", "minLength": 1},
    "detector_id": {"type": "string", "minLength": 1},
    "detector_version": {"type": "string", "minLength": 1},
    "adapter_version": {"type": ["string", "null"]},
    "task_id": {"type": "string", "minLength": 1},
    "estimand": {"type": "string", "minLength": 1},
    "resampling_cluster_field": {"type": "string", "minLength": 1},
    "independent_group_count": {"type": "integer", "minimum": 0},
    "valid_run_count": {"type": "integer", "minimum": 0},
    "eligible_status_denominator": {"type": "integer", "minimum": 0},
    "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "exclusions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "threshold_id": {"type": ["string", "null"]},
    "calibrator_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"card_type": {"const": "dataset"}}, "required": ["card_type"]},
      "then": {
        "required": [
          "dataset_id", "dataset_snapshot_id", "purpose", "excluded_uses",
          "collection_generation_dates", "annotation_scheme_id",
          "label_ontology_and_adjudication", "composition",
          "language_domain_length_distributions", "prompt_generation_configuration",
          "assistance_workflows", "rights_status", "consent_and_access",
          "pii_handling", "deduplication_contamination_checks", "split_construction",
          "independent_group_count", "resampling_cluster_field",
          "retention_access_controls", "transformations", "manifest_hash"
        ]
      }
    },
    {
      "if": {"properties": {"card_type": {"const": "detector"}}, "required": ["card_type"]},
      "then": {
        "required": [
          "detector_id", "detector_version", "adapter_version", "task_id",
          "config_hash", "native_signals", "supported_scope",
          "eligible_denominator_policy", "calibration_ids", "threshold_ids",
          "hardware", "latency", "cost", "policy_snapshot",
          "drift_retest_date", "contact"
        ]
      }
    },
    {
      "if": {"properties": {"card_type": {"const": "result"}}, "required": ["card_type"]},
      "then": {
        "required": [
          "result_id", "task_id", "estimand", "excluded_uses", "mode",
          "dataset_card_ref", "detector_card_ref", "dataset_id",
          "dataset_snapshot_id", "annotation_scheme_id", "dataset_dates",
          "registry_and_rights", "label_basis", "class_counts",
          "split_construction", "detector_id", "detector_version",
          "adapter_version", "model_version", "config_hash", "hardware",
          "latency", "cost", "api_policy_snapshot", "independent_group_count",
          "resampling_cluster_field", "valid_run_count",
          "eligible_status_denominator", "coverage", "status_counts",
          "exclusions", "ranking_metrics", "uncertainty", "threshold_id",
          "calibrator_id", "threshold_policy", "common_call_comparison",
          "missingness_analysis", "prevalence_scenarios", "strata",
          "unsupported_cells", "robustness", "ablations",
          "detector_correlation", "multiplicity_status", "negative_findings",
          "human_ratings", "track_d_verification", "drift_retest_date",
          "reproducibility_manifest", "contact"
        ]
      }
    }
  ]
}
