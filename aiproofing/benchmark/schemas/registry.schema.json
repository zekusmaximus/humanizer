{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/registry.schema.json",
  "title": "Benchmark v2 registry snapshot",
  "type": "object",
  "required": ["schema_version", "registry", "registry_version", "snapshot_hash_scope", "entries"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "registry": {"enum": ["datasets", "annotation_schemes", "detectors", "licenses", "consents", "tools", "evidence_sources", "decision_schemas", "oversight_crosswalks"]},
    "registry_version": {"type": "string", "minLength": 1},
    "snapshot_hash_scope": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "version", "status", "source_reference", "reviewed_at", "snapshot_hash"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "source_reference": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+]00:00)$"},
          "snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "allowed_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_snapshot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "version_card_refs": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
          "snapshot_card_refs": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
