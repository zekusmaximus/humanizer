{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/validation_report.schema.json",
  "title": "Benchmark v2 validation or migration report",
  "type": "object",
  "required": ["schema_version", "record_type", "input_sha256", "row_count", "record_counts", "issue_counts", "strict_exit_status"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"enum": ["validation_report", "migration_report"]},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strict_exit_status": {"type": "integer"}
  }
}
