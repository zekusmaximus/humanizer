{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanizer.local/schemas/ground_truth_span.schema.json",
  "title": "Benchmark v2 ground-truth span",
  "type": "object",
  "required": ["schema_version", "record_type", "span_id", "revision_id", "normalized_text_sha256", "annotation_normalization", "offset_unit", "start", "end", "span_label", "ground_truth_basis", "label_status"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "record_type": {"const": "ground_truth_span"},
    "span_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "normalized_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotation_normalization": {"type": "string", "minLength": 1},
    "offset_unit": {"const": "unicode_codepoint"},
    "start": {"type": "integer", "minimum": 0},
    "end": {"type": "integer", "minimum": 1},
    "span_label": {"enum": ["human", "machine", "assisted", "unknown"]},
    "ground_truth_basis": {"enum": ["controlled_generation_log", "version_history_adjudicated", "author_attested", "dataset_claim", "unknown"]},
    "label_status": {"enum": ["verified", "adjudicated", "attested", "provisional", "unknown"]}
  }
}
